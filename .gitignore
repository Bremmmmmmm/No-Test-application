## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache directory
.vs/

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Rider
.idea/
*.sln.iml

# dotCover report files
OpenCover/

# NUnit 3 - Not expecting user to manually edit this file
.nunit

nupkg/
*.snupkg

# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/

# Uncomment if necessary however generally it will be regenerated when needed
#!**/packages/repositories.config

# NuGet v3's project.json files makes it harder to support both project.json and packages.config at the same time
# so the xproj file is not needed anymore.
*.xproj

# Cake - Uncomment if you are using it
# tools/**
# !tools/packages.config

# Tabs Studio
*.tss

# Telerik's JustMock binaries
*.jmconfig

# BizTalk build output
*.btp.cs
*.btm.cs
*.odx.cs
*.xsd.cs

# OpenCover UI analysis results
OpenCoverUI/

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Jet Brains Rider
.idea/
*.sln.iml

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Local user-specific settings
launchSettings.json

# Database
*.db
*.mdb
*.sqlite
*.sqlite3

# Environment files
.env
.env.local

# OS files
.DS_Store
Thumbs.db
